# Copy to .env. Never commit real credentials.

# The pipeline Sentinel reads. Read-only: Sentinel never writes to the source
# schema. A read-only role is the right credential here (see docs/operations.md).
SENTINEL_SOURCE_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Where Sentinel keeps its own incidents. Defaults to the source database,
# in a separate "sentinel" schema, which is one less thing to provision.
# SENTINEL_DATABASE_URL=

# --- narration (optional) ----------------------------------------------------
# Sentinel classifies without a model. Ollama only turns a finished, structured
# incident into prose -- see ADR-0003. Leave these alone to run without it.
# SENTINEL_OLLAMA_URL=http://localhost:11434
# SENTINEL_OLLAMA_MODEL=llama3.1:8b
# SENTINEL_NARRATE=false
